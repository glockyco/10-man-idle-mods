---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InfoBox from "../../components/ui/InfoBox.astro";
import LootTable from "../../components/ui/LootTable.astro";
import { getAllQuestIds, getQuest, getQuestRewards } from "../../data/quests";
import { formatDuration, formatGold } from "../../data/helpers";

export function getStaticPaths() {
  return getAllQuestIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const quest = getQuest(id);

if (!quest) {
  return Astro.redirect("/quests/");
}

const rewards = getQuestRewards(id);

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Quests", href: "/quests/" },
  { label: quest.name },
];

const detailRows = [
  { label: "Type", value: quest.type },
  { label: "Min Level", value: String(quest.min_character_level) },
  { label: "Rec. Combat Power", value: String(quest.recommended_combat_power) },
  { label: "Duration", value: formatDuration(quest.base_duration) },
];

const rewardRows = [
  { label: "Gold", value: formatGold(quest.gold_reward) },
  { label: "Experience", value: String(quest.experience_reward) },
];
---

<BaseLayout title={quest.name} crumbs={crumbs}>
  <h1 class="text-2xl font-bold">{quest.name}</h1>
  {quest.description && <p class="text-muted mt-2">{quest.description}</p>}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
    <div class="space-y-6">
      <InfoBox title="Details" rows={detailRows} />
      <InfoBox title="Rewards" rows={rewardRows} />
    </div>
    <div>
      <LootTable title="Item Rewards" drops={rewards} />
    </div>
  </div>
</BaseLayout>
