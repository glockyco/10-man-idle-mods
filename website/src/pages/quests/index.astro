---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllQuests } from "../../data/quests";

const quests = getAllQuests();
const types = [...new Set(quests.map((q) => q.type))].sort();
const questsByType = types.map((t) => ({
  type: t,
  quests: quests.filter((q) => q.type === t),
}));
---

<BaseLayout title="Quests">
  <h1>Quests</h1>
  <p style="color: var(--text-dim); margin: 0.5rem 0;">{quests.length} quests across {types.length} types</p>

  {questsByType.map((group) => (
    <div style="margin-top: 2rem;">
      <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">{group.type} ({group.quests.length})</h2>
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border); text-align: left;">
            <th style="padding: 0.5rem;">Name</th>
            <th style="padding: 0.5rem;">Level</th>
            <th style="padding: 0.5rem;">Rec. CP</th>
            <th style="padding: 0.5rem;">Duration</th>
            <th style="padding: 0.5rem;">Gold</th>
            <th style="padding: 0.5rem;">XP</th>
          </tr>
        </thead>
        <tbody>
          {group.quests.map((q) => (
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 0.5rem;"><a href={`/quests/${q.id}/`}>{q.name}</a></td>
              <td style="padding: 0.5rem;">{q.min_character_level}</td>
              <td style="padding: 0.5rem;">{q.recommended_combat_power}</td>
              <td style="padding: 0.5rem; color: var(--text-dim);">{Math.round(q.base_duration)}s</td>
              <td style="padding: 0.5rem;">{q.gold_reward}g</td>
              <td style="padding: 0.5rem;">{q.experience_reward}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}
</BaseLayout>
