---
import { formatDuration, formatGold, questUrl } from "../../data/helpers";
import { getAllQuests } from "../../data/quests";
import BaseLayout from "../../layouts/BaseLayout.astro";

const quests = getAllQuests();
const types = [...new Set(quests.map((q) => q.type))].sort();
const questsByType = types.map((t) => ({
  questType: t,
  quests: quests.filter((q) => q.type === t),
}));

const crumbs = [{ label: "Home", href: "/" }, { label: "Quests" }];
---

<BaseLayout title="Quests" crumbs={crumbs}>
  <h1 class="text-2xl font-bold">Quests</h1>
  <p class="text-muted mt-2">{quests.length} quests across {types.length} types</p>

  {questsByType.map((group) => (
    <div class="mt-8">
      <h2 class="text-lg text-highlight mb-3">{group.questType} ({group.quests.length})</h2>
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b-2 border-border text-left">
            <th class="p-2 text-sm text-muted font-semibold">Name</th>
            <th class="p-2 text-sm text-muted font-semibold">Level</th>
            <th class="p-2 text-sm text-muted font-semibold">Rec. CP</th>
            <th class="p-2 text-sm text-muted font-semibold">Duration</th>
            <th class="p-2 text-sm text-muted font-semibold">Gold</th>
            <th class="p-2 text-sm text-muted font-semibold">XP</th>
          </tr>
        </thead>
        <tbody>
          {group.quests.map((q) => (
            <tr class="border-b border-border">
              <td class="p-2"><a href={questUrl(q.id)}>{q.name}</a></td>
              <td class="p-2">{q.min_character_level}</td>
              <td class="p-2">{q.recommended_combat_power}</td>
              <td class="p-2 text-muted">{formatDuration(q.base_duration)}</td>
              <td class="p-2">{formatGold(q.gold_reward)}</td>
              <td class="p-2">{q.experience_reward}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}
</BaseLayout>
