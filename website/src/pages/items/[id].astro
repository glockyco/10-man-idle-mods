---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InfoBox from "../../components/ui/InfoBox.astro";
import SourcesList from "../../components/ui/SourcesList.astro";
import RarityBadge from "../../components/ui/RarityBadge.astro";
import {
  getAllItemIds,
  getAllToolIds,
  getItem,
  getTool,
  getItemClasses,
  getRecipesProducingItem,
  getRecipesUsingItem,
  getItemSources,
} from "../../data/items";
import {
  rarityClass,
  formatSpeedBonus,
  formatGold,
} from "../../data/helpers";

export function getStaticPaths() {
  const items = getAllItemIds();
  const tools = getAllToolIds();
  return [...items, ...tools].map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const item = getItem(id);
const tool = !item ? getTool(id) : null;

if (!item && !tool) {
  return Astro.redirect("/items/");
}

const recipeOutput = getRecipesProducingItem(id);
const classes = item ? getItemClasses(id) : [];
const recipesUsedIn = item ? getRecipesUsingItem(id) : [];
const allSources = item ? getItemSources(id) : [];

const itemRows = item ? [
  { label: "Category", value: item.category },
  { label: "Rarity", value: item.rarity, class: rarityClass(item.rarity) },
  { label: "Item Level", value: String(item.item_level) },
  ...(item.slot ? [{ label: "Slot", value: item.slot }] : []),
  ...(item.armor_type ? [{ label: "Armor Type", value: item.armor_type }] : []),
  ...(item.combat_power > 0 ? [{ label: "Combat Power", value: String(item.combat_power) }] : []),
  ...(item.material_type ? [{ label: "Material", value: item.material_type }] : []),
  { label: "Base Value", value: formatGold(item.base_value) },
  { label: "Max Stack", value: String(item.max_stack_size) },
  ...(item.consumable_type ? [{ label: "Consumable", value: item.consumable_type }] : []),
] : [];

const toolRows = tool ? [
  { label: "Category", value: "Gathering Tool" },
  { label: "Skill", value: tool.skill },
  { label: "Speed Bonus", value: formatSpeedBonus(tool.speed_bonus) },
] : [];

const crumbs = tool
  ? [{ label: "Home", href: "/" }, { label: "Gathering", href: "/gathering/" }, { label: tool.skill, href: `/gathering/${tool.skill}/` }, { label: tool.name }]
  : [{ label: "Home", href: "/" }, { label: "Items", href: "/items/" }, { label: item!.name }];
---

<BaseLayout title={tool?.name ?? item!.name} crumbs={crumbs}>
  {tool ? (
    <h1 class="text-2xl font-bold mt-2">{tool.name}</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
      <InfoBox title="Properties" rows={toolRows}>
        <div class="mt-2">
          <a href={`/gathering/${tool.skill}/`} class="text-sm">{tool.skill} &rarr;</a>
        </div>
      </InfoBox>

      <div>
        {recipeOutput.length > 0 && (
          <div class="bg-surface border border-border rounded-lg p-5">
            <h2 class="text-lg text-highlight mb-3">Crafted By</h2>
            <ul class="space-y-1">
              {recipeOutput.map((r) => (
                <li><a href={`/recipes/${r.id}/`}>{r.name}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  ) : (
    <>
      <h1 class={`text-2xl font-bold mt-2 ${rarityClass(item!.rarity)}`}>{item!.name}</h1>
      <RarityBadge rarity={item!.rarity} />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
        <div>
          <InfoBox title="Properties" rows={itemRows}>
            {classes.length > 0 && (
              <div class="mt-3 pt-3 border-t border-border">
                <h3 class="text-sm text-highlight mb-1">Allowed Classes</h3>
                <p>{classes.join(", ")}</p>
              </div>
            )}
          </InfoBox>
        </div>

        <div class="space-y-4">
          <SourcesList sources={allSources} />

          {recipesUsedIn.length > 0 && (
            <div class="bg-surface border border-border rounded-lg p-5">
              <h2 class="text-lg text-highlight mb-3">Used In</h2>
              <ul class="space-y-1">
                {recipesUsedIn.map((r) => (
                  <li><a href={`/recipes/${r.recipe_id}/`}>{r.recipe_name}</a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </>
  )}
</BaseLayout>
