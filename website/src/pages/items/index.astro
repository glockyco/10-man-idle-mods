---
import ItemLink from "../../components/ui/ItemLink.astro";
import { getAllItems } from "../../data/items";
import BaseLayout from "../../layouts/BaseLayout.astro";

const items = getAllItems();

const crumbs = [{ label: "Home", href: "/" }, { label: "Items" }];

const categories = [...new Set(items.map((i) => i.category))].sort();
const rarities = ["Common", "Uncommon", "Rare", "Epic", "Legendary"];
const slots = [...new Set(items.filter((i) => i.slot).map((i) => i.slot!))].sort();
---

<BaseLayout title="Items" crumbs={crumbs}>
  <h1 class="text-2xl font-bold">Items</h1>
  <p class="text-muted mt-1 mb-4">{items.length} items</p>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse" id="items-table">
      <thead>
        <tr class="border-b-2 border-border text-left">
          <th class="p-2 text-sm text-muted font-semibold">Name</th>
          <th class="p-2 text-sm text-muted font-semibold">Category</th>
          <th class="p-2 text-sm text-muted font-semibold">Rarity</th>
          <th class="p-2 text-sm text-muted font-semibold">Level</th>
          <th class="p-2 text-sm text-muted font-semibold">Slot</th>
          <th class="p-2 text-sm text-muted font-semibold">CP</th>
        </tr>
      </thead>
      <tbody>
        {items.map((item) => (
          <tr class="border-b border-border">
            <td class="p-2">
              <ItemLink id={item.id} name={item.name} rarity={item.rarity} />
            </td>
            <td class="p-2 text-muted">{item.category}</td>
            <td class="p-2">
              <span class={`text-rarity-${item.rarity.toLowerCase()}`}>{item.rarity}</span>
            </td>
            <td class="p-2">{item.item_level}</td>
            <td class="p-2 text-muted">{item.slot ?? "—"}</td>
            <td class="p-2">{item.combat_power || "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BaseLayout>
