---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { query, hasDb } from "../../lib/db";

interface Dungeon {
  id: string;
  name: string;
  difficulty: string;
  required_guild_level: number;
  recommended_combat_power: number;
  base_duration: number;
  gold_reward: number;
  experience_reward: number;
}

const dungeons = query<Dungeon>(
  "SELECT * FROM dungeons ORDER BY required_guild_level, name"
);
---

<BaseLayout title="Dungeons">
  <h1>Dungeons</h1>
  {!hasDb && <p style="color: var(--text-dim);">Database not found. Run the DataExporter mod first.</p>}
  {hasDb && (
    <p style="color: var(--text-dim); margin: 0.5rem 0;">{dungeons.length} dungeons</p>
    <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border); text-align: left;">
          <th style="padding: 0.5rem;">Name</th>
          <th style="padding: 0.5rem;">Difficulty</th>
          <th style="padding: 0.5rem;">Guild Lvl</th>
          <th style="padding: 0.5rem;">Rec. CP</th>
          <th style="padding: 0.5rem;">Duration</th>
          <th style="padding: 0.5rem;">Gold</th>
          <th style="padding: 0.5rem;">XP</th>
        </tr>
      </thead>
      <tbody>
        {dungeons.map((d) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 0.5rem;"><a href={`/dungeons/${d.id}/`}>{d.name}</a></td>
            <td style="padding: 0.5rem; color: var(--text-dim);">{d.difficulty}</td>
            <td style="padding: 0.5rem;">{d.required_guild_level}</td>
            <td style="padding: 0.5rem;">{d.recommended_combat_power}</td>
            <td style="padding: 0.5rem; color: var(--text-dim);">{Math.round(d.base_duration)}s</td>
            <td style="padding: 0.5rem;">{d.gold_reward}g</td>
            <td style="padding: 0.5rem;">{d.experience_reward}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</BaseLayout>
