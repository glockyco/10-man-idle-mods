---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllDungeons } from "../../data/dungeons";
import { dungeonUrl, formatDuration, formatGold } from "../../data/helpers";

const dungeons = getAllDungeons();

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Dungeons" },
];
---

<BaseLayout title="Dungeons" crumbs={crumbs}>
  <h1 class="text-2xl font-bold">Dungeons</h1>
  <p class="text-muted mt-2">{dungeons.length} dungeons</p>
  <table class="w-full border-collapse mt-4">
    <thead>
      <tr class="border-b-2 border-border text-left">
        <th class="p-2 text-sm text-muted font-semibold">Name</th>
        <th class="p-2 text-sm text-muted font-semibold">Difficulty</th>
        <th class="p-2 text-sm text-muted font-semibold">Guild Lvl</th>
        <th class="p-2 text-sm text-muted font-semibold">Rec. CP</th>
        <th class="p-2 text-sm text-muted font-semibold">Duration</th>
        <th class="p-2 text-sm text-muted font-semibold">Gold</th>
        <th class="p-2 text-sm text-muted font-semibold">XP</th>
      </tr>
    </thead>
    <tbody>
      {dungeons.map((d) => (
        <tr class="border-b border-border">
          <td class="p-2"><a href={dungeonUrl(d.id)}>{d.name}</a></td>
          <td class="p-2 text-muted">{d.difficulty}</td>
          <td class="p-2">{d.required_guild_level}</td>
          <td class="p-2">{d.recommended_combat_power}</td>
          <td class="p-2 text-muted">{formatDuration(d.base_duration)}</td>
          <td class="p-2">{formatGold(d.gold_reward)}</td>
          <td class="p-2">{d.experience_reward}</td>
        </tr>
      ))}
    </tbody>
  </table>
</BaseLayout>
