---
import InfoBox from "../../components/ui/InfoBox.astro";
import LootTable from "../../components/ui/LootTable.astro";
import { getAllDungeonIds, getDungeon, getDungeonLoot } from "../../data/dungeons";
import { formatDuration, formatGold } from "../../data/helpers";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getAllDungeonIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const dungeon = getDungeon(id);

if (!dungeon) {
  return Astro.redirect("/dungeons/");
}

const loot = getDungeonLoot(id);

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Dungeons", href: "/dungeons/" },
  { label: dungeon.name },
];

const requirementRows = [
  { label: "Difficulty", value: dungeon.difficulty },
  { label: "Guild Level", value: String(dungeon.required_guild_level) },
  { label: "Rec. Combat Power", value: String(dungeon.recommended_combat_power) },
  { label: "Duration", value: formatDuration(dungeon.base_duration) },
];

const rewardRows = [
  { label: "Gold", value: formatGold(dungeon.gold_reward) },
  { label: "Experience", value: String(dungeon.experience_reward) },
];
---

<BaseLayout title={dungeon.name} crumbs={crumbs}>
  <h1 class="text-2xl font-bold">{dungeon.name}</h1>
  {dungeon.description && <p class="text-muted mt-2">{dungeon.description}</p>}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
    <div class="space-y-6">
      <InfoBox title="Requirements" rows={requirementRows} />
      <InfoBox title="Rewards" rows={rewardRows} />
    </div>
    <div>
      <LootTable title="Loot Table" drops={loot} />
    </div>
  </div>
</BaseLayout>
