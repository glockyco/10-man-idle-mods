---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ItemLink from "../../components/ui/ItemLink.astro";
import { getAllRecipes } from "../../data/recipes";
import { recipeUrl, formatGold } from "../../data/helpers";

const recipes = getAllRecipes();
const skills = [...new Set(recipes.map((r) => r.skill))].sort();
const recipesBySkill = skills.map((s) => ({
  skill: s,
  recipes: recipes.filter((r) => r.skill === s),
}));

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Recipes" },
];
---

<BaseLayout title="Recipes" crumbs={crumbs}>
  <h1 class="text-2xl font-bold">Recipes</h1>
  <p class="text-muted mt-2">{recipes.length} recipes across {skills.length} professions</p>

  {recipesBySkill.map((group) => (
    <div class="mt-8">
      <h2 class="text-lg text-highlight mb-3">{group.skill} ({group.recipes.length})</h2>
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b-2 border-border text-left">
            <th class="p-2 text-sm text-muted font-semibold">Recipe</th>
            <th class="p-2 text-sm text-muted font-semibold">Level</th>
            <th class="p-2 text-sm text-muted font-semibold">Output</th>
            <th class="p-2 text-sm text-muted font-semibold">Qty</th>
            <th class="p-2 text-sm text-muted font-semibold">Gold Cost</th>
          </tr>
        </thead>
        <tbody>
          {group.recipes.map((r) => (
            <tr class="border-b border-border">
              <td class="p-2">
                <a href={recipeUrl(r.id)}>{r.name}</a>
              </td>
              <td class="p-2">{r.required_level}</td>
              <td class="p-2">
                {r.output_item_id ? (
                  <ItemLink id={r.output_item_id} name={r.output_item_name} />
                ) : (
                  <span class="text-muted">&mdash;</span>
                )}
              </td>
              <td class="p-2">{r.output_quantity}</td>
              <td class="p-2">{formatGold(r.gold_cost)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}
</BaseLayout>
