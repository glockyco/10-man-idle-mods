---
import InfoBox from "../../components/ui/InfoBox.astro";
import ItemLink from "../../components/ui/ItemLink.astro";
import { formatDuration, formatGold, rarityClass } from "../../data/helpers";
import {
  getAllRecipeIds,
  getRecipe,
  getRecipeIngredients,
  getRecipeOutput,
} from "../../data/recipes";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getAllRecipeIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const recipe = getRecipe(id);

if (!recipe) {
  return Astro.redirect("/recipes/");
}

const ingredients = getRecipeIngredients(id);
const output = getRecipeOutput(recipe);

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Recipes", href: "/recipes/" },
  { label: recipe.name },
];

const detailRows = [
  { label: "Profession", value: recipe.skill },
  { label: "Required Level", value: String(recipe.required_level) },
  { label: "Duration", value: formatDuration(recipe.duration) },
  { label: "Gold Cost", value: formatGold(recipe.gold_cost) },
];
---

<BaseLayout title={recipe.name} crumbs={crumbs}>
  <h1 class="text-2xl font-bold">{recipe.name}</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
    <div class="space-y-6">
      <InfoBox title="Details" rows={detailRows} />

      {ingredients.length > 0 && (
        <div class="bg-surface border border-border rounded-lg p-5">
          <h2 class="text-lg text-highlight mb-3">Ingredients</h2>
          <ul class="list-none space-y-1">
            {ingredients.map((ing) => (
              <li class="flex items-center gap-2">
                <ItemLink id={ing.item_id} name={ing.item_name} />
                <span class="text-muted">x{ing.quantity}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div>
      {output.kind === "item" && (
        <div class="bg-surface border border-border rounded-lg p-5">
          <h2 class="text-lg text-highlight mb-3">Output</h2>
          <p>
            <a href={output.url} class={rarityClass(output.item.rarity)}>{output.item.name}</a>
            {recipe.output_quantity > 1 && (
              <span class="text-muted"> x{recipe.output_quantity}</span>
            )}
          </p>
        </div>
      )}
      {output.kind === "tool" && (
        <div class="bg-surface border border-border rounded-lg p-5">
          <h2 class="text-lg text-highlight mb-3">Output</h2>
          <p>
            <a href={output.url}>{output.tool.name}</a>
            {recipe.output_quantity > 1 && (
              <span class="text-muted"> x{recipe.output_quantity}</span>
            )}
          </p>
        </div>
      )}
      {output.kind === "unknown" && output.id && (
        <div class="bg-surface border border-border rounded-lg p-5">
          <h2 class="text-lg text-highlight mb-3">Output</h2>
          <p>
            <span>{output.id}</span>
            {recipe.output_quantity > 1 && (
              <span class="text-muted"> x{recipe.output_quantity}</span>
            )}
          </p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
