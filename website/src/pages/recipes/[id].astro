---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { query, queryOne } from "../../lib/db";

interface Recipe {
  id: string;
  name: string;
  skill: string;
  required_level: number;
  duration: number;
  output_item_id: string;
  output_quantity: number;
  gold_cost: number;
}

interface OutputItem {
  id: string;
  name: string;
  rarity: string;
}

interface Ingredient {
  item_id: string;
  item_name: string;
  quantity: number;
}

export function getStaticPaths() {
  const recipes = query<{ id: string }>("SELECT id FROM recipes");
  return recipes.map((r) => ({ params: { id: r.id } }));
}

const { id } = Astro.params;
const recipe = queryOne<Recipe>("SELECT * FROM recipes WHERE id = ?", [id]);

if (!recipe) {
  return Astro.redirect("/recipes/");
}

const outputItem = recipe.output_item_id
  ? queryOne<OutputItem>("SELECT id, name, rarity FROM items WHERE id = ?", [recipe.output_item_id])
  : null;

const ingredients = query<Ingredient>(
  `SELECT ri.item_id, i.name as item_name, ri.quantity
   FROM recipe_ingredients ri LEFT JOIN items i ON ri.item_id = i.id
   WHERE ri.recipe_id = ?`,
  [id]
);

const rarityColor: Record<string, string> = {
  Common: "var(--common)",
  Uncommon: "var(--uncommon)",
  Rare: "var(--rare)",
  Epic: "var(--epic)",
  Legendary: "var(--legendary)",
};
---

<BaseLayout title={recipe.name}>
  <p><a href="/recipes/">&larr; All Recipes</a></p>
  <h1 style="margin-top: 0.5rem;">{recipe.name}</h1>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.5rem;">
    <div>
      <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Details</h2>
      <table style="width: 100%;">
        <tbody>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Profession</td><td>{recipe.skill}</td></tr>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Required Level</td><td>{recipe.required_level}</td></tr>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Duration</td><td>{recipe.duration}s</td></tr>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Gold Cost</td><td>{recipe.gold_cost}g</td></tr>
        </tbody>
      </table>

      {ingredients.length > 0 && (
        <h2 style="color: var(--text-highlight); margin-top: 1.5rem; margin-bottom: 0.5rem;">Ingredients</h2>
        <ul style="list-style: none;">
          {ingredients.map((ing) => (
            <li style="padding: 0.25rem 0;">
              {ing.item_name ? (
                <a href={`/items/${ing.item_id}/`}>{ing.item_name}</a>
              ) : (
                <span>{ing.item_id}</span>
              )}
              <span style="color: var(--text-dim);"> x{ing.quantity}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div>
      {outputItem && (
        <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Output</h2>
        <p>
          <a href={`/items/${outputItem.id}/`} style={`color: ${rarityColor[outputItem.rarity] ?? "var(--text)"}`}>
            {outputItem.name}
          </a>
          {recipe.output_quantity > 1 && (
            <span style="color: var(--text-dim);"> x{recipe.output_quantity}</span>
          )}
        </p>
      )}
    </div>
  </div>
</BaseLayout>
