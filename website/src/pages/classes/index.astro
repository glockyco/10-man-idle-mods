---
import RoleBadge from "../../components/ui/RoleBadge.astro";
import { getAllClasses } from "../../data/classes";
import { classUrl } from "../../data/helpers";
import BaseLayout from "../../layouts/BaseLayout.astro";

const classes = getAllClasses();

const crumbs = [{ label: "Home", href: "/" }, { label: "Classes" }];
---

<BaseLayout title="Classes" crumbs={crumbs}>
  <h1 class="text-2xl font-bold">Classes</h1>
  <p class="text-muted mt-2">{classes.length} classes</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
    {classes.map((c) => (
      <a href={classUrl(c.name)} class="block p-5 bg-surface border border-border rounded-lg hover:border-highlight hover:no-underline transition-colors">
        <h2 class="text-highlight mb-1">{c.name}</h2>
        <p class="text-muted text-sm mb-2">Armor: {c.armor_type}</p>
        <div class="flex gap-2">
          {c.roles.split(",").map((role) => (
            <RoleBadge role={role} />
          ))}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
