---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InfoBox from "../../components/ui/InfoBox.astro";
import RoleBadge from "../../components/ui/RoleBadge.astro";
import ItemLink from "../../components/ui/ItemLink.astro";
import { getAllClassNames, getClass, getClassEquipment } from "../../data/classes";

export function getStaticPaths() {
  return getAllClassNames().map((name) => ({ params: { name } }));
}

const { name } = Astro.params;
const cls = getClass(name);

if (!cls) {
  return Astro.redirect("/classes/");
}

const equipment = getClassEquipment(name);

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Classes", href: "/classes/" },
  { label: cls.name },
];

const overviewRows = [
  { label: "Armor Type", value: cls.armor_type },
];
---

<BaseLayout title={cls.name} crumbs={crumbs}>
  <h1 class="text-2xl font-bold">{cls.name}</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
    <div>
      <InfoBox title="Overview" rows={overviewRows}>
        <div class="flex justify-between py-1">
          <span class="text-muted">Roles</span>
          <span class="flex gap-2">
            {cls.roles.split(",").map((role) => (
              <RoleBadge role={role} />
            ))}
          </span>
        </div>
      </InfoBox>
    </div>

    {equipment.length > 0 && (
      <div>
        <h2 class="text-lg text-highlight mb-3">Equipment ({equipment.length})</h2>
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b-2 border-border text-left">
              <th class="p-2 text-sm text-muted font-semibold">Name</th>
              <th class="p-2 text-sm text-muted font-semibold">Level</th>
              <th class="p-2 text-sm text-muted font-semibold">Slot</th>
              <th class="p-2 text-sm text-muted font-semibold">CP</th>
            </tr>
          </thead>
          <tbody>
            {equipment.map((item) => (
              <tr class="border-b border-border">
                <td class="p-2">
                  <ItemLink id={item.id} name={item.name} rarity={item.rarity} />
                </td>
                <td class="p-2">{item.item_level}</td>
                <td class="p-2 text-muted">{item.slot ?? "\u2014"}</td>
                <td class="p-2">{item.combat_power || "\u2014"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>
