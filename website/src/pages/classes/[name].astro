---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllClassNames, getClass, getClassEquipment } from "../../data/classes";

export function getStaticPaths() {
  return getAllClassNames().map((name) => ({ params: { name } }));
}

const { name } = Astro.params;
const cls = getClass(name);

if (!cls) {
  return Astro.redirect("/classes/");
}

const equipment = getClassEquipment(name);

const rarityColor: Record<string, string> = {
  Common: "var(--common)",
  Uncommon: "var(--uncommon)",
  Rare: "var(--rare)",
  Epic: "var(--epic)",
  Legendary: "var(--legendary)",
};

const roleColor: Record<string, string> = {
  Tank: "var(--rare)",
  Healer: "var(--uncommon)",
  DPS: "var(--accent)",
};
---

<BaseLayout title={cls.name}>
  <p><a href="/classes/">&larr; All Classes</a></p>
  <h1 style="margin-top: 0.5rem;">{cls.name}</h1>

  <div style="margin-top: 1.5rem;">
    <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Overview</h2>
    <table style="width: auto;">
      <tbody>
        <tr><td style="color: var(--text-dim); padding: 0.25rem 1rem 0.25rem 0;">Armor Type</td><td>{cls.armor_type}</td></tr>
        <tr>
          <td style="color: var(--text-dim); padding: 0.25rem 1rem 0.25rem 0;">Roles</td>
          <td>
            {cls.roles.split(",").map((role, i) => (
              <>
                {i > 0 && ", "}
                <span style={`color: ${roleColor[role] ?? "var(--text)"}`}>{role}</span>
              </>
            ))}
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {equipment.length > 0 && (
    <div style="margin-top: 2rem;">
      <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Equipment ({equipment.length})</h2>
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border); text-align: left;">
            <th style="padding: 0.5rem;">Name</th>
            <th style="padding: 0.5rem;">Level</th>
            <th style="padding: 0.5rem;">Slot</th>
            <th style="padding: 0.5rem;">CP</th>
          </tr>
        </thead>
        <tbody>
          {equipment.map((item) => (
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 0.5rem;">
                <a href={`/items/${item.id}/`} style={`color: ${rarityColor[item.rarity] ?? "var(--text)"}`}>
                  {item.name}
                </a>
              </td>
              <td style="padding: 0.5rem;">{item.item_level}</td>
              <td style="padding: 0.5rem; color: var(--text-dim);">{item.slot ?? "—"}</td>
              <td style="padding: 0.5rem;">{item.combat_power || "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</BaseLayout>
