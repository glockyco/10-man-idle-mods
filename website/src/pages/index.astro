---
import CategoryCard from "../components/ui/CategoryCard.astro";
import { getAllClasses } from "../data/classes";
import { getAllDungeons } from "../data/dungeons";
import { getAllNodes, getAllTools } from "../data/gathering";
import { getAllItems } from "../data/items";
import { getAllQuests } from "../data/quests";
import { getAllRaids } from "../data/raids";
import { getAllRecipes } from "../data/recipes";
import BaseLayout from "../layouts/BaseLayout.astro";

const items = getAllItems();
const recipes = getAllRecipes();
const dungeons = getAllDungeons();
const raids = getAllRaids();
const quests = getAllQuests();
const nodes = getAllNodes();
const tools = getAllTools();
const classes = getAllClasses();
---

<BaseLayout title="Home">
  <h1 class="text-2xl font-bold">10-Man Codex</h1>
  <p class="text-muted mt-4">
    Community game data codex for 10-Man Idle. All data is extracted
    directly from the game files.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    <CategoryCard
      href="/gathering/"
      title="Gathering"
      description="Gathering skills, nodes, and tools"
      count={`${nodes.length} nodes, ${tools.length} tools`}
    />
    <CategoryCard
      href="/recipes/"
      title="Crafting"
      description="Crafting recipes by profession"
      count={`${recipes.length} recipes`}
    />
    <CategoryCard
      href="/quests/"
      title="Quests"
      description="Quest list by type and level"
      count={`${quests.length} quests`}
    />
    <CategoryCard
      href="/dungeons/"
      title="Dungeons"
      description="Dungeon info, loot tables, requirements"
      count={`${dungeons.length} dungeons`}
    />
    <CategoryCard
      href="/raids/"
      title="Raids"
      description="Raid encounters and exclusive loot"
      count={`${raids.length} raids`}
    />
    <CategoryCard
      href="/items/"
      title="Items"
      description="Equipment, materials, and consumables"
      count={`${items.length} items`}
    />
    <CategoryCard
      href="/classes/"
      title="Classes"
      description="Character classes, roles, and armor types"
      count={`${classes.length} classes`}
    />
  </div>
</BaseLayout>
