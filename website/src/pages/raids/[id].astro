---
import InfoBox from "../../components/ui/InfoBox.astro";
import LootTable from "../../components/ui/LootTable.astro";
import { formatDuration, formatGold } from "../../data/helpers";
import { getAllRaidIds, getRaid, getRaidLoot } from "../../data/raids";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getAllRaidIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const raid = getRaid(id);

if (!raid) {
  return Astro.redirect("/raids/");
}

const loot = getRaidLoot(id);

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Raids", href: "/raids/" },
  { label: raid.name },
];

const requirementRows = [
  { label: "Difficulty", value: raid.difficulty },
  { label: "Guild Level", value: String(raid.required_guild_level) },
  { label: "Rec. Combat Power", value: String(raid.recommended_combat_power) },
  { label: "Duration", value: formatDuration(raid.base_duration) },
];

const rewardRows = [
  { label: "Gold", value: formatGold(raid.gold_reward) },
  { label: "Experience", value: String(raid.experience_reward) },
];
---

<BaseLayout title={raid.name} crumbs={crumbs}>
  <h1 class="text-2xl font-bold">{raid.name}</h1>
  {raid.description && <p class="text-muted mt-2">{raid.description}</p>}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
    <div class="space-y-6">
      <InfoBox title="Requirements" rows={requirementRows} />
      <InfoBox title="Rewards" rows={rewardRows} />
    </div>
    <div>
      <LootTable title="Loot Table" drops={loot} />
    </div>
  </div>
</BaseLayout>
