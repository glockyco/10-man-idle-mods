---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { query, queryOne } from "../../lib/db";

interface Raid {
  id: string;
  name: string;
  description: string | null;
  required_guild_level: number;
  difficulty: string;
  recommended_combat_power: number;
  base_duration: number;
  gold_reward: number;
  experience_reward: number;
}

interface LootDrop {
  item_id: string;
  item_name: string;
  item_rarity: string;
  min_quantity: number;
  max_quantity: number;
  chance: number;
}

export function getStaticPaths() {
  const raids = query<{ id: string }>("SELECT id FROM raids");
  return raids.map((r) => ({ params: { id: r.id } }));
}

const { id } = Astro.params;
const raid = queryOne<Raid>("SELECT * FROM raids WHERE id = ?", [id]);

if (!raid) {
  return Astro.redirect("/raids/");
}

const loot = query<LootDrop>(
  `SELECT rl.item_id, i.name as item_name, i.rarity as item_rarity,
          rl.min_quantity, rl.max_quantity, rl.chance
   FROM raid_loot rl LEFT JOIN items i ON rl.item_id = i.id
   WHERE rl.raid_id = ?
   ORDER BY rl.chance DESC`,
  [id]
);

const rarityColor: Record<string, string> = {
  Common: "var(--common)",
  Uncommon: "var(--uncommon)",
  Rare: "var(--rare)",
  Epic: "var(--epic)",
  Legendary: "var(--legendary)",
};
---

<BaseLayout title={raid.name}>
  <p><a href="/raids/">&larr; All Raids</a></p>
  <h1 style="margin-top: 0.5rem;">{raid.name}</h1>
  {raid.description && <p style="color: var(--text-dim); margin-top: 0.5rem;">{raid.description}</p>}

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.5rem;">
    <div>
      <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Requirements</h2>
      <table style="width: 100%;">
        <tbody>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Difficulty</td><td>{raid.difficulty}</td></tr>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Guild Level</td><td>{raid.required_guild_level}</td></tr>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Rec. Combat Power</td><td>{raid.recommended_combat_power}</td></tr>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Duration</td><td>{Math.round(raid.base_duration)}s</td></tr>
        </tbody>
      </table>

      <h2 style="color: var(--text-highlight); margin-top: 1.5rem; margin-bottom: 0.5rem;">Rewards</h2>
      <table style="width: 100%;">
        <tbody>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Gold</td><td>{raid.gold_reward}g</td></tr>
          <tr><td style="color: var(--text-dim); padding: 0.25rem 0;">Experience</td><td>{raid.experience_reward}</td></tr>
        </tbody>
      </table>
    </div>

    <div>
      {loot.length > 0 && (
        <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Loot Table</h2>
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border); text-align: left;">
              <th style="padding: 0.5rem;">Item</th>
              <th style="padding: 0.5rem;">Qty</th>
              <th style="padding: 0.5rem;">Chance</th>
            </tr>
          </thead>
          <tbody>
            {loot.map((l) => (
              <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 0.5rem;">
                  <a href={`/items/${l.item_id}/`} style={`color: ${rarityColor[l.item_rarity] ?? "var(--text)"}`}>
                    {l.item_name}
                  </a>
                </td>
                <td style="padding: 0.5rem; color: var(--text-dim);">
                  {l.min_quantity === l.max_quantity ? l.min_quantity : `${l.min_quantity}-${l.max_quantity}`}
                </td>
                <td style="padding: 0.5rem;">{(l.chance * 100).toFixed(0)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>
</BaseLayout>
