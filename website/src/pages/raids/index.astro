---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllRaids } from "../../data/raids";

const raids = getAllRaids();
---

<BaseLayout title="Raids">
  <h1>Raids</h1>
  <p style="color: var(--text-dim); margin: 0.5rem 0;">{raids.length} raids</p>
  <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
    <thead>
      <tr style="border-bottom: 2px solid var(--border); text-align: left;">
        <th style="padding: 0.5rem;">Name</th>
        <th style="padding: 0.5rem;">Difficulty</th>
        <th style="padding: 0.5rem;">Guild Lvl</th>
        <th style="padding: 0.5rem;">Rec. CP</th>
        <th style="padding: 0.5rem;">Duration</th>
        <th style="padding: 0.5rem;">Gold</th>
        <th style="padding: 0.5rem;">XP</th>
      </tr>
    </thead>
    <tbody>
      {raids.map((r) => (
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 0.5rem;"><a href={`/raids/${r.id}/`}>{r.name}</a></td>
          <td style="padding: 0.5rem; color: var(--text-dim);">{r.difficulty}</td>
          <td style="padding: 0.5rem;">{r.required_guild_level}</td>
          <td style="padding: 0.5rem;">{r.recommended_combat_power}</td>
          <td style="padding: 0.5rem; color: var(--text-dim);">{Math.round(r.base_duration)}s</td>
          <td style="padding: 0.5rem;">{r.gold_reward}g</td>
          <td style="padding: 0.5rem;">{r.experience_reward}</td>
        </tr>
      ))}
    </tbody>
  </table>
</BaseLayout>
