---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllRaids } from "../../data/raids";
import { raidUrl, formatDuration, formatGold } from "../../data/helpers";

const raids = getAllRaids();

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Raids" },
];
---

<BaseLayout title="Raids" crumbs={crumbs}>
  <h1 class="text-2xl font-bold">Raids</h1>
  <p class="text-muted mt-2">{raids.length} raids</p>
  <table class="w-full border-collapse mt-4">
    <thead>
      <tr class="border-b-2 border-border text-left">
        <th class="p-2 text-sm text-muted font-semibold">Name</th>
        <th class="p-2 text-sm text-muted font-semibold">Difficulty</th>
        <th class="p-2 text-sm text-muted font-semibold">Guild Lvl</th>
        <th class="p-2 text-sm text-muted font-semibold">Rec. CP</th>
        <th class="p-2 text-sm text-muted font-semibold">Duration</th>
        <th class="p-2 text-sm text-muted font-semibold">Gold</th>
        <th class="p-2 text-sm text-muted font-semibold">XP</th>
      </tr>
    </thead>
    <tbody>
      {raids.map((r) => (
        <tr class="border-b border-border">
          <td class="p-2"><a href={raidUrl(r.id)}>{r.name}</a></td>
          <td class="p-2 text-muted">{r.difficulty}</td>
          <td class="p-2">{r.required_guild_level}</td>
          <td class="p-2">{r.recommended_combat_power}</td>
          <td class="p-2 text-muted">{formatDuration(r.base_duration)}</td>
          <td class="p-2">{formatGold(r.gold_reward)}</td>
          <td class="p-2">{r.experience_reward}</td>
        </tr>
      ))}
    </tbody>
  </table>
</BaseLayout>
