---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ItemLink from "../../components/ui/ItemLink.astro";
import {
  getDistinctSkills,
  getNodesBySkill,
  getToolsBySkill,
  getDropsBySkill,
} from "../../data/gathering";
import {
  itemUrl,
  formatDuration,
  formatSpeedBonus,
  formatQuantityRange,
  formatChance,
} from "../../data/helpers";

export function getStaticPaths() {
  return getDistinctSkills().map((skill) => ({ params: { skill } }));
}

const { skill } = Astro.params;

const nodes = getNodesBySkill(skill);

if (nodes.length === 0) {
  return Astro.redirect("/gathering/");
}

const drops = getDropsBySkill(skill);
const dropsByNode = new Map<string, typeof drops>();
for (const d of drops) {
  const list = dropsByNode.get(d.node_id) ?? [];
  list.push(d);
  dropsByNode.set(d.node_id, list);
}

const tools = getToolsBySkill(skill);

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Gathering", href: "/gathering/" },
  { label: skill },
];
---

<BaseLayout title={`${skill} - Gathering`} crumbs={crumbs}>
  <h1 class="text-2xl font-bold">{skill}</h1>

  {tools.length > 0 && (
    <div class="mt-6">
      <h2 class="text-lg text-highlight mb-3">Tools</h2>
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b-2 border-border text-left">
            <th class="p-2 text-sm text-muted font-semibold">Name</th>
            <th class="p-2 text-sm text-muted font-semibold">Speed Bonus</th>
          </tr>
        </thead>
        <tbody>
          {tools.map((t) => (
            <tr class="border-b border-border">
              <td class="p-2"><a href={itemUrl(t.id)}>{t.name}</a></td>
              <td class="p-2">{formatSpeedBonus(t.speed_bonus)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <div class="mt-8">
    <h2 class="text-lg text-highlight mb-3">Nodes ({nodes.length})</h2>
    {nodes.map((node) => {
      const nodeDrops = dropsByNode.get(node.id) ?? [];
      return (
        <div class="mt-4 p-4 bg-surface border border-border rounded-lg">
          <h3 class="text-highlight font-semibold">{node.name}</h3>
          <p class="text-muted text-sm mt-1">
            Level {node.required_level} &middot; {formatDuration(node.base_duration)} base duration
          </p>
          {nodeDrops.length > 0 && (
            <table class="w-full border-collapse mt-3">
              <thead>
                <tr class="border-b border-border text-left">
                  <th class="py-1 px-2 text-sm text-muted font-semibold">Drop</th>
                  <th class="py-1 px-2 text-sm text-muted font-semibold">Qty</th>
                  <th class="py-1 px-2 text-sm text-muted font-semibold">Chance</th>
                </tr>
              </thead>
              <tbody>
                {nodeDrops.map((d) => (
                  <tr>
                    <td class="py-1 px-2">
                      <ItemLink id={d.item_id} name={d.item_name} rarity={d.item_rarity} />
                    </td>
                    <td class="py-1 px-2 text-muted">{formatQuantityRange(d.min_quantity, d.max_quantity)}</td>
                    <td class="py-1 px-2">{formatChance(d.chance)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      );
    })}
  </div>
</BaseLayout>
