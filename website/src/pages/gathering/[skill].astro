---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getDistinctSkills,
  getNodesBySkill,
  getToolsBySkill,
  getDropsBySkill,
} from "../../data/gathering";

export function getStaticPaths() {
  return getDistinctSkills().map((skill) => ({ params: { skill } }));
}

const { skill } = Astro.params;

const nodes = getNodesBySkill(skill);

if (nodes.length === 0) {
  return Astro.redirect("/gathering/");
}

const drops = getDropsBySkill(skill);
const dropsByNode = new Map<string, typeof drops>();
for (const d of drops) {
  const list = dropsByNode.get(d.node_id) ?? [];
  list.push(d);
  dropsByNode.set(d.node_id, list);
}

const tools = getToolsBySkill(skill);

const rarityColor: Record<string, string> = {
  Common: "var(--common)",
  Uncommon: "var(--uncommon)",
  Rare: "var(--rare)",
  Epic: "var(--epic)",
  Legendary: "var(--legendary)",
};
---

<BaseLayout title={`${skill} - Gathering`}>
  <p><a href="/gathering/">&larr; All Gathering Skills</a></p>
  <h1 style="margin-top: 0.5rem;">{skill}</h1>

  {tools.length > 0 && (
    <div style="margin-top: 1.5rem;">
      <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Tools</h2>
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border); text-align: left;">
            <th style="padding: 0.5rem;">Name</th>
            <th style="padding: 0.5rem;">Speed Bonus</th>
          </tr>
        </thead>
        <tbody>
          {tools.map((t) => (
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 0.5rem;"><a href={`/items/${t.id}/`}>{t.name}</a></td>
              <td style="padding: 0.5rem;">+{(t.speed_bonus * 100).toFixed(0)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <div style="margin-top: 2rem;">
    <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">Nodes ({nodes.length})</h2>
    {nodes.map((node) => {
      const nodeDrops = dropsByNode.get(node.id) ?? [];
      return (
        <div style="margin-top: 1rem; padding: 1rem; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 8px;">
          <h3 style="color: var(--text-highlight);">{node.name}</h3>
          <p style="color: var(--text-dim); margin: 0.25rem 0;">
            Level {node.required_level} &middot; {node.base_duration}s base duration
          </p>
          {nodeDrops.length > 0 && (
            <table style="width: 100%; border-collapse: collapse; margin-top: 0.5rem;">
              <thead>
                <tr style="border-bottom: 1px solid var(--border); text-align: left;">
                  <th style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Drop</th>
                  <th style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Qty</th>
                  <th style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Chance</th>
                </tr>
              </thead>
              <tbody>
                {nodeDrops.map((d) => (
                  <tr>
                    <td style="padding: 0.25rem 0.5rem;">
                      <a href={`/items/${d.item_id}/`} style={`color: ${rarityColor[d.item_rarity ?? ""] ?? "var(--text)"}`}>
                        {d.item_name ?? d.item_id}
                      </a>
                    </td>
                    <td style="padding: 0.25rem 0.5rem; color: var(--text-dim);">
                      {d.min_quantity === d.max_quantity ? d.min_quantity : `${d.min_quantity}-${d.max_quantity}`}
                    </td>
                    <td style="padding: 0.25rem 0.5rem;">{(d.chance * 100).toFixed(0)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      );
    })}
  </div>
</BaseLayout>
