---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { query, hasDb } from "../../lib/db";

interface GatheringNode {
  id: string;
  name: string;
  skill: string;
  required_level: number;
  base_duration: number;
}

interface GatheringTool {
  id: string;
  name: string;
  skill: string;
  speed_bonus: number;
}

const nodes = query<GatheringNode>(
  "SELECT * FROM gathering_nodes ORDER BY skill, required_level, name"
);

const tools = query<GatheringTool>(
  "SELECT * FROM gathering_tools ORDER BY skill, speed_bonus"
);

const skills = [...new Set(nodes.map((n) => n.skill))].sort();
---

<BaseLayout title="Gathering">
  <h1>Gathering</h1>
  {!hasDb && <p style="color: var(--text-dim);">Database not found. Run the DataExporter mod first.</p>}
  {hasDb && (
    <p style="color: var(--text-dim); margin: 0.5rem 0;">{skills.length} skills, {nodes.length} nodes, {tools.length} tools</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
      {skills.map((skill) => {
        const skillNodes = nodes.filter((n) => n.skill === skill);
        const skillTools = tools.filter((t) => t.skill === skill);
        return (
          <a href={`/gathering/${skill}/`} style="display: block; padding: 1.5rem; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 8px;">
            <h2 style="color: var(--text-highlight); margin-bottom: 0.5rem;">{skill}</h2>
            <p style="color: var(--text-dim);">{skillNodes.length} nodes, {skillTools.length} tools</p>
          </a>
        );
      })}
    </div>
  )}
</BaseLayout>
