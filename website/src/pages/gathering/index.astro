---
import CategoryCard from "../../components/ui/CategoryCard.astro";
import { getAllNodes, getAllTools } from "../../data/gathering";
import { gatheringUrl } from "../../data/helpers";
import BaseLayout from "../../layouts/BaseLayout.astro";

const nodes = getAllNodes();
const tools = getAllTools();
const skills = [...new Set(nodes.map((n) => n.skill))].sort();

const skillCards = skills.map((skill) => {
  const skillNodes = nodes.filter((n) => n.skill === skill);
  const skillTools = tools.filter((t) => t.skill === skill);
  return {
    skill,
    nodeCount: skillNodes.length,
    toolCount: skillTools.length,
  };
});

const crumbs = [{ label: "Home", href: "/" }, { label: "Gathering" }];
---

<BaseLayout title="Gathering" crumbs={crumbs}>
  <h1 class="text-2xl font-bold">Gathering</h1>
  <p class="text-muted mt-2">{skills.length} skills, {nodes.length} nodes, {tools.length} tools</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
    {skillCards.map((card) => (
      <CategoryCard
        href={gatheringUrl(card.skill)}
        title={card.skill}
        description={`${card.nodeCount} nodes, ${card.toolCount} tools`}
      />
    ))}
  </div>
</BaseLayout>
