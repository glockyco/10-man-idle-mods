---
import "../styles/global.css";
import Nav from "../components/layout/Nav.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import Footer from "../components/layout/Footer.astro";
import HoverPreview from "../components/interactive/hover-preview.astro";

interface Props {
  title: string;
  description?: string;
  crumbs?: { label: string; href?: string }[];
}

const {
  title,
  description = "Game data codex for 10-Man Idle",
  crumbs,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} - 10-Man Codex</title>
  </head>
  <body>
    <Nav />
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <main class="max-w-[1200px] mx-auto px-4 py-8" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <HoverPreview />
  </body>
</html>
