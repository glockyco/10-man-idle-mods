<Project>
  <!-- Import user-local settings (gitignored) if present -->
  <Import Project="Directory.Build.props.user"
          Condition="Exists('Directory.Build.props.user')" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!-- Fallback: read GameDir from environment variable -->
  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir>$(TENMAN_GAME_DIR)</GameDir>
  </PropertyGroup>
</Project>
